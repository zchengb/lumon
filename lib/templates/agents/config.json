{
  "enabled": false,
  "profiles": {
    "dylan": {
      "role": "scan",
      "workflow": "auto_scan"
    },
    "mark": {
      "role": "delivery",
      "workflow": "auto_delivery"
    },
    "irving": {
      "role": "patch",
      "workflow": "auto_patch"
    },
    "milchick": {
      "role": "orchestrator",
      "workflow": null
    }
  },
  "access": {
    "default_policy": "legacy_allow",
    "owners": [],
    "admins": [],
    "agents": {
      "dylan": {
        "exposure_mode": "owner_private",
        "allowed_user_ids": [],
        "allowed_chat_ids": [],
        "dm_only": true,
        "host_read": "selected",
        "host_read_capabilities": ["host.disk.summary", "host.runtime.summary"],
        "mutation_allowed_user_ids": []
      },
      "mark": {
        "exposure_mode": "restricted_team",
        "allowed_user_ids": [],
        "allowed_chat_ids": [],
        "dm_only": false,
        "host_read": "deny",
        "mutation_allowed_user_ids": []
      },
      "irving": {
        "exposure_mode": "restricted_team",
        "allowed_user_ids": [],
        "allowed_chat_ids": [],
        "dm_only": false,
        "host_read": "deny",
        "mutation_allowed_user_ids": []
      },
      "milchick": {
        "exposure_mode": "admin_private",
        "allowed_user_ids": [],
        "allowed_chat_ids": [],
        "dm_only": true,
        "host_read": "system_only",
        "host_read_capabilities": ["lumen.system.health", "lumen.agent.status", "lumen.runner.status"],
        "mutation_allowed_user_ids": []
      }
    }
  },
  "dylan": {
    "max_concurrent_jobs": 3,
    "conversation_v4": {
      "enabled": false,
      "mode": "autonomous_workspace",
      "provider": {
        "type": "deepseek",
        "model": "deepseek-v4-flash",
        "base_url": "https://api.deepseek.com",
        "api_key_env": "DEEPSEEK_API_KEY",
        "output_format": "text",
        "resume_sessions": false
      },
      "session": {
        "scope": "thread_shared",
        "idle_after_hours": 24,
        "archive_after_days": 30,
        "reset_on_workspace_change": true
      },
      "workspace": {
        "stable_path_required": true,
        "generate_agents_md": true,
        "permission_profile": "workspace_autonomous"
      },
      "runtime": {
        "soft_timeout_seconds": 90,
        "hard_timeout_seconds": 300,
        "max_concurrent_sessions": 3,
        "serialize_same_session": true
      },
      "reaction": {
        "enabled": true,
        "emoji_type": "Typing",
        "add_immediately": true,
        "remove_on_success": true,
        "remove_on_failure": true,
        "cleanup_after_seconds": 120
      },
      "observability": {
        "log_level": "INFO",
        "jsonl_enabled": true,
        "trace_enabled": true,
        "record_tool_events": true,
        "record_assistant_deltas": false,
        "redact_secrets": true
      },
      "soul": {
        "version": "2",
        "bootstrap_once": true
      }
    },
    "conversation_v3": {
      "enabled": false,
      "routing_mode": "agent_only",
      "model": {
        "provider": "deepseek",
        "model": "deepseek-v4-flash",
        "base_url": "https://api.deepseek.com",
        "api_key_env": "DEEPSEEK_API_KEY",
        "planner_timeout_seconds": 45,
        "responder_timeout_seconds": 60,
        "max_planner_retries": 1,
        "max_responder_retries": 1,
        "required": true
      },
      "agent_loop": {
        "max_iterations": 2,
        "max_tool_calls": 8,
        "max_total_tool_seconds": 20,
        "allow_multi_task": true
      },
      "reaction": {
        "enabled": true,
        "emoji_type": "Typing",
        "add_immediately": true,
        "remove_on_success": true,
        "remove_on_failure": true,
        "cleanup_after_seconds": 120
      },
      "observability": {
        "log_level": "INFO",
        "jsonl_enabled": true,
        "trace_enabled": true,
        "store_model_io": false,
        "model_io_retention_days": 3,
        "redact_secrets": true
      }
    },
    "risk_analyst": {
      "enabled": false,
      "conversation_v2": {
        "enabled": false,
        "llm_router_enabled": false,
        "llm_response_enabled": false,
        "grounding_guard_enabled": true,
        "model": {
          "provider": "deepseek",
          "router_timeout_seconds": 8,
          "response_timeout_seconds": 25,
          "max_router_retries": 1,
          "max_response_retries": 1
        },
        "typing": {
          "enabled": true,
          "delay_ms": 350,
          "progress_after_ms": 5000,
          "long_wait_after_ms": 15000,
          "overall_timeout_ms": 45000,
          "max_updates": 4
        }
      }
    }
  },
    "mark": {
    "max_concurrent_jobs": 3,
    "test_case": {
      "projects": {
        "mbpass": {
