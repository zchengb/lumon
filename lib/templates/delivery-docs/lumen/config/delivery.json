{
  "schema_version": "1.0",
  "execution": {
    "provider": "opencode",
    "model": "deepseek-v4-flash",
    "base_url": "",
    "api_key_env": "DEEPSEEK_API_KEY",
    "patch_provider": "opencode",
    "patch_model": "deepseek-v4-flash",
    "patch_base_url": "",
    "patch_api_key_env": "DEEPSEEK_API_KEY",
    "sandbox": "disabled",
    "approve_mcps": false,
    "agent_timeout_seconds": 3600,
    "agent_idle_timeout_seconds": 900
  },
  "jira": {
    "enabled": true,
    "auto_enable_when_twg_ready": true,
    "site": "",
    "in_dev_status": "IN DEV",
    "dev_done_status": "DEV DONE",
    "blocked_status": "Block"
  },
  "notifications": {
    "feishu": {
      "enabled": true
    }
  },
  "observability": {
    "agent_trace": {
      "enabled": true,
      "capture_mode": "metadata",
      "retention_days": 14
    }
  },
  "automation": {
    "cleanup_worktrees_on_success": true,
    "scheduled_delivery": {
      "enabled": false,
      "eligible_jira_statuses": ["To Do", "Backlog", "In Progress"],
      "required_jira_status": "To Do"
    },
    "scheduled_auto_patch": {
      "enabled": false,
      "poll_interval_minutes": 5,
      "eligible_jira_statuses": ["To Do"],
      "issue_types": ["Task", "Bug"],
      "in_progress_status": "In Progress",
      "done_status": "Done",
      "blocked_status": "Block"
    }
  },
  "publish": {
    "auto_patch": {
      "mode": "pr"
    }
  },
  "verification": {
    "auto_run_after_agent": true,
    "fail_on_error": true,
    "remediation": {
      "enabled": true,
      "max_attempts": 2
    },
    "docker": {
      "mode": "host_testcontainers",
      "required_for": ["integration_test"],
      "check_before_run": true,
      "skip_if_unavailable": false
    },
    "java_gradle": {
      "strategy": "compile, PMD when configured, then full Gradle test suite"
    },
    "steps": {}
  }
}
