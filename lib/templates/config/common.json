{
  "schema_version": "1.0",
  "product": {
    "name": "Lumen",
    "tagline": "Engineering, made legible.",
    "codename": "lumen"
  },
  "project": {
    "display_name": "",
    "workspace_root": ""
  },
  "agent_security": {
    "mode": "trusted_dedicated_machine",
    "workspace_isolation_v2": false,
    "provider_sandbox": "unrestricted",
    "canonical_workspace_access": "read_write",
    "agent_world_backend": "host",
    "boundary_backend": "host_user",
    "world_contract": "agent-world/1-trusted",
    "delete_policy": "prompt_only",
    "secret_isolation": false,
    "identity_mode": "host_user",
    "host_visibility": "full",
    "network": "allow"
  },
  "access": {
    "default_policy": "deny",
    "authorization_mode": "gate_only",
    "allowed_chat_ids": [],
    "allowed_user_ids": [],
    "admin_user_ids": []
  },
  "harness": {
    "mode": "unshackled",
    "task_mode_enforcement": "advisory",
    "allow_workspace_write": true,
    "allow_shell": true,
    "allow_build": true,
    "allow_tests": true,
    "allow_scripts": true,
    "allow_web": true,
    "allow_question": true,
    "allow_skills": true,
    "allow_subagents": true,
    "allow_multi_repo": true,
    "allow_native_tools": true
  },
  "agent_collaboration": {
    "thread_native_handoff": true,
    "max_relay_hops": 4,
    "context_max_chars": 24000
  },
  "conversation": {
    "version": "3.3",
    "default_language": "zh-Hant",
    "native_first": true,
    "legacy_compatibility": false,
    "visible_workstream": true,
    "native_tools": true,
    "native_questions": true,
    "minimum_event_interval_seconds": 3,
    "dedupe_window_seconds": 10
  },
  "execution": {
    "mode": "harness_native",
    "provider": "opencode",
    "model": "deepseek-v4-flash",
    "base_url": "",
    "api_key_env": "DEEPSEEK_API_KEY",
    "scan_window_days": 7,
    "run_project_commands": true,
    "validation_policy": "agent_selected_relevant_validation",
    "workspace_strategy": "canonical_workspace",
    "keep_worktrees_after_run": false,
    "max_worktrees_per_repo": 1,
    "create_pr_for_severity": ["High"]
  },
  "paths": {
    "config_dir": "config",
    "tmp_dir": "tmp",
    "worktrees_dir": "worktrees",
    "results_dir": "results",
    "reports_dir": "reports",
    "logs_dir": "logs",
    "state_dir": "state",
    "issue_registry": "state/issue-registry.json",
    "dashboard_html": "dashboard.html",
    "dashboard_data_js": "dashboard-data.js"
  },
  "retention": {
    "enabled": true,
    "keep_latest_run_dirs": 1,
    "keep_result_days": 90,
    "keep_report_days": 90,
    "keep_log_days": 30,
    "cleanup_worktrees_before_run": true,
    "cleanup_only_auto_scan_paths": true
  },
  "issue_tracking": {
    "enabled": true,
    "fingerprint_strategy": "repository:file:normalized_title:issue_type:trigger_hash",
    "carry_open_issues_across_scan_windows": true,
    "do_not_drop_unresolved_issues_after_scan_window": true,
    "statuses": [
      "open",
      "in_progress",
      "pr_open",
      "resolved",
      "accepted_risk",
      "false_positive",
      "ignored"
    ],
    "stale_after_days": 7,
    "include_stale_open_issues_in_report": false
  },
  "reporting": {
    "html_first": true,
    "dashboard_enabled": true,
    "dashboard_path": "dashboard.html",
    "dashboard_scope": "all_historical_runs",
    "html_path_pattern": "reports/code-quality-security-scan-YYYY-MM-DD.html",
    "pdf_path_pattern": "reports/code-quality-security-scan-YYYY-MM-DD.pdf",
    "style": "minimal",
    "pdf_engine_preference": ["chrome"]
  },
  "security": {
    "redact_secrets": true,
    "redaction_token": "[REDACTED]",
    "never_include_secret_values": true,
    "report_secret_findings_without_value": true
  },
  "notifications": {
    "feishu_webhook_env": "FEISHU_WEBHOOK_URL",
    "feishu": {
      "enabled": true
    },
    "send_exactly_one_card": true,
    "include_pdf_path_in_card": false,
    "jira": {
      "enabled": true,
      "project_key": "MBPAS",
      "board_id": "",
      "assign_to_active_sprint": false,
      "issue_type": "Bug",
      "severities": ["High", "Medium", "Low"],
      "summary_prefix": "[Lumen]"
    }
  },
  "git": {
    "branch_prefix": "auto-fix",
    "commit_message_strategy": "lumen_standard",
    "commit_message_prefix": "[lumen]",
    "ticket_placeholder": "#MBPAS-XXXX",
    "inspect_recent_commit_count": 20,
    "never_push_default_branch": true
  }
}
